# Database - local Supabase (port 54332; does not conflict with readytowork-local)
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:54332/postgres
PAYLOAD_SECRET=YOUR_SECRET_HERE # Generate it!
BLOB_READ_WRITE_TOKEN=YOUR_READ_WRITE_TOKEN_HERE # Vercel Blob Example

RESEND_API_KEY=re_xxxxxxxx # Email Configuration
EMAIL_FROM=noreply@yourdomain.com # Email Configuration

# Agent (LangGraph + OpenAI)
OPENAI_API_KEY=sk-xxxxxxxx
# AGENT_LLM_MODEL=gpt-4.1-mini      # default (fast). Use gpt-5 for quality but ~20–40s per turn
# AGENT_LLM_TEMPERATURE=0.2        # ignored for gpt-5 / o-series (API only allows default)
# AGENT_CHECKPOINT_SCHEMA=agent_checkpoints
# AGENT_CHECKPOINT_DATABASE_URI=    # optional override; defaults to DATABASE_URI
# AGENT_DEBUG=true                  # verbose [agent] logs in production
# NEXT_PUBLIC_APP_URL=http://localhost:3000  # base URL for draft invoice review links in agent chat
# AGENT_E2E_MOCK=1  # test only: deterministic /api/agent/chat SSE (see docs/agent-testing.md)

# Supabase prod DB (used by Vercel and by: pnpm run push-to-prod)
# SUPABASE_URL=postgresql://postgres.xxx:password@aws-0-xx.pooler.supabase.com:6543/postgres
# SUPABASE_ANON_KEY=your-anon-key  # optional, for /api/ping if using Supabase JS client
